#version 440 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer ParticlePositionBuffer
{
	vec4 particlePositions[];
};

layout(std430, binding = 1) buffer ParticleVelocityBuffer
{
	vec4 particleVelocities[];
};

layout(std430, binding = 2) buffer ParticleColorBuffer
{
	vec4 particleColors[];
};

layout(std430, binding = 3) buffer ParticleLifetimeBuffer
{
	vec2 particleLifetimes[];
};

layout(std430, binding = 4) buffer ParticleAliveIndexBuffer
{
	uint aliveParticleIndices[];
};

layout(std430, binding = 5) buffer ParticleCounterBuffer
{
	uint aliveCount;
	uint spawnedCountThisFrame;
	uint totalSpawnCount;
	uint reserved;
};

layout(std430, binding = 7) buffer ParticleEndColorBuffer
{
	vec4 particleEndColors[];
};

layout(std430, binding = 8) buffer ParticleSizeBuffer
{
	vec2 particleSizes[];
};

layout(std430, binding = 9) buffer ParticleRotationBuffer
{
	vec4 particleRotations[];
};

layout(std430, binding = 10) buffer ParticleAccelerationBuffer
{
	vec4 particleAccelerations[];
};

layout(std430, binding = 11) buffer ParticleAngularVelocityBuffer
{
	vec4 particleAngularVelocities[];
};

uniform int particleCount;
uniform float deltaTime;
uniform vec3 gravity;
uniform int requestedSpawnCount;
uniform vec2 lifetimeRange;
uniform vec3 initialVelocityMin;
uniform vec3 initialVelocityMax;
uniform vec3 initialRotationMin;
uniform vec3 initialRotationMax;
uniform vec3 angularVelocityMin;
uniform vec3 angularVelocityMax;
uniform vec3 accelerationMin;
uniform vec3 accelerationMax;
uniform float velocityLimit;
uniform bool infiniteLifetime;
uniform vec2 initialSizeRange;
uniform vec2 sizeByLifetime;
uniform vec3 spawnBoxExtents;
uniform vec4 colorByLifetimeStart;
uniform vec4 colorByLifetimeEnd;
uniform mat4 previousEmitterMatrix;
uniform mat4 currentEmitterMatrix;

const float INFINITE_LIFETIME_SENTINEL = -1.0;

uint Hash(uint value)
{
	value ^= value >> 16;
	value *= 0x7feb352du;
	value ^= value >> 15;
	value *= 0x846ca68bu;
	value ^= value >> 16;
	return value;
}

float Random01(inout uint state)
{
	state = Hash(state + 0x9e3779b9u);
	return float(state) / 4294967295.0;
}

float RandomRange(inout uint state, vec2 rangeValues)
{
	return mix(rangeValues.x, rangeValues.y, Random01(state));
}

vec3 RandomRange(inout uint state, vec3 minValue, vec3 maxValue)
{
	return vec3(
		mix(minValue.x, maxValue.x, Random01(state)),
		mix(minValue.y, maxValue.y, Random01(state)),
		mix(minValue.z, maxValue.z, Random01(state)));
}

vec3 RandomPointInBox(inout uint state, vec3 extents)
{
	return vec3(
		mix(-extents.x, extents.x, Random01(state)),
		mix(-extents.y, extents.y, Random01(state)),
		mix(-extents.z, extents.z, Random01(state)));
}

vec3 SafeNormalize(vec3 value)
{
	float valueLength = length(value);
	return valueLength > 0.0001 ? value / valueLength : vec3(0.0);
}

vec3 TransformLocalVectorByEmitter(mat4 emitterMatrix, vec3 localVector)
{
	// Engine local axes: +x forward, +y left, +z up.
	// Spawn positions use vec4(localPosition, 1.0) * emitterMatrix in this shader,
	// so use the same convention with w = 0.0 for direction vectors.
	vec3 emitterForward = SafeNormalize((vec4(1.0, 0.0, 0.0, 0.0) * emitterMatrix).xyz);
	vec3 emitterLeft = SafeNormalize((vec4(0.0, 1.0, 0.0, 0.0) * emitterMatrix).xyz);
	vec3 emitterUp = SafeNormalize((vec4(0.0, 0.0, 1.0, 0.0) * emitterMatrix).xyz);

	return emitterForward * localVector.x +
		emitterLeft * localVector.y +
		emitterUp * localVector.z;
}

void ClampVelocity(inout vec4 velocity)
{
	if (velocityLimit <= 0.0)
	{
		return;
	}

	float speed = length(velocity.xyz);
	if (speed > velocityLimit)
	{
		velocity.xyz = velocity.xyz * (velocityLimit / max(speed, 0.0001));
	}
}

void PackAliveParticle(uint particleIndex)
{
	uint aliveSlot = atomicAdd(aliveCount, 1u);
	aliveParticleIndices[aliveSlot] = particleIndex;
}

bool IsInfiniteLifetime(vec2 lifetime)
{
	return lifetime.y < 0.0;
}

bool IsAliveLifetime(vec2 lifetime)
{
	return lifetime.x > 0.0 || IsInfiniteLifetime(lifetime);
}

void main()
{
	uint particleIndex = gl_GlobalInvocationID.x;
	if (particleIndex >= uint(particleCount))
	{
		return;
	}

	vec2 lifetime = particleLifetimes[particleIndex];
	if (IsAliveLifetime(lifetime))
	{
		vec4 velocity = particleVelocities[particleIndex];
		vec4 position = particlePositions[particleIndex];
		vec4 rotation = particleRotations[particleIndex];
		vec3 acceleration = particleAccelerations[particleIndex].xyz;
		vec3 angularVelocity = particleAngularVelocities[particleIndex].xyz;

		velocity.xyz += (gravity + acceleration) * deltaTime;
		ClampVelocity(velocity);
		position.xyz += velocity.xyz * deltaTime;
		rotation.xyz += angularVelocity * deltaTime;
		if (!IsInfiniteLifetime(lifetime))
		{
			lifetime.x = max(lifetime.x - deltaTime, 0.0);
		}

		particleVelocities[particleIndex] = velocity;
		particlePositions[particleIndex] = position;
		particleRotations[particleIndex] = rotation;
		particleLifetimes[particleIndex] = lifetime;

		if (IsAliveLifetime(lifetime))
		{
			PackAliveParticle(particleIndex);
		}
		return;
	}

	if (requestedSpawnCount <= 0)
	{
		return;
	}

	uint spawnRequestIndex = atomicAdd(spawnedCountThisFrame, 1u);
	if (spawnRequestIndex >= uint(requestedSpawnCount))
	{
		return;
	}

	uint spawnSequence = atomicAdd(totalSpawnCount, 1u);
	uint randomState = Hash(spawnSequence * 1664525u + particleIndex * 1013904223u + 1u);

	vec3 localSpawnPosition = RandomPointInBox(randomState, spawnBoxExtents);
	float spawnLerpAlpha = Random01(randomState);
	vec3 previousWorldPosition = (vec4(localSpawnPosition, 1.0) * previousEmitterMatrix).xyz;
	vec3 currentWorldPosition = (vec4(localSpawnPosition, 1.0) * currentEmitterMatrix).xyz;

	float initialLifetime = infiniteLifetime ? INFINITE_LIFETIME_SENTINEL : RandomRange(randomState, lifetimeRange);
	float initialSize = RandomRange(randomState, initialSizeRange);
	vec3 initialVelocity = TransformLocalVectorByEmitter(
		currentEmitterMatrix,
		RandomRange(randomState, initialVelocityMin, initialVelocityMax));
	vec3 initialRotation = RandomRange(randomState, initialRotationMin, initialRotationMax);
	vec3 angularVelocity = RandomRange(randomState, angularVelocityMin, angularVelocityMax);
	vec3 acceleration = TransformLocalVectorByEmitter(
		currentEmitterMatrix,
		RandomRange(randomState, accelerationMin, accelerationMax));

	vec4 velocity = vec4(initialVelocity, 0.0);
	ClampVelocity(velocity);

	particlePositions[particleIndex] = vec4(mix(previousWorldPosition, currentWorldPosition, spawnLerpAlpha), 1.0);
	particleVelocities[particleIndex] = velocity;
	particleColors[particleIndex] = colorByLifetimeStart;
	particleEndColors[particleIndex] = colorByLifetimeEnd;
	particleLifetimes[particleIndex] = vec2(initialLifetime, initialLifetime);
	particleSizes[particleIndex] = sizeByLifetime * initialSize;
	particleRotations[particleIndex] = vec4(initialRotation, 0.0);
	particleAccelerations[particleIndex] = vec4(acceleration, 0.0);
	particleAngularVelocities[particleIndex] = vec4(angularVelocity, 0.0);

	PackAliveParticle(particleIndex);
}
