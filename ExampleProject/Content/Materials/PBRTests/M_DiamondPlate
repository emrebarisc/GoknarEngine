	// Optimized shader graph calculations
	vec2 product = (textureUV * vec2(2.0, 2.0));
	vec4 t_DiamondPlate_ColorSample = texture(T_DiamondPlate_Color, (vec2(fract((product).x), fract((product).y)) * T_DiamondPlate_Color_UVTransform.xy + T_DiamondPlate_Color_UVTransform.zw));
	vec4 t_DiamondPlate_NormalSample = texture(T_DiamondPlate_Normal, (vec2(fract((product).x), fract((product).y)) * T_DiamondPlate_Normal_UVTransform.xy + T_DiamondPlate_Normal_UVTransform.zw));
	vec4 difference = ((t_DiamondPlate_NormalSample * 2.0) - vec4(1.0, 1.0, 1.0, 1.0));
	vec4 t_DiamondPlate_ORMWSample = texture(T_DiamondPlate_ORMW, (vec2(fract((product).x), fract((product).y)) * T_DiamondPlate_ORMW_UVTransform.xy + T_DiamondPlate_ORMW_UVTransform.zw));
</Calculation>
        <Result>t_DiamondPlate_ColorSample;</Result>
    </BaseColor>
