        <Calculation></Calculation>
        <Result>(t_DiamondPlate_ORMWSample).x;</Result>
    </AmbientOcclusion>
    <Metallic>
        <Calculation></Calculation>
        <Result>(t_DiamondPlate_ORMWSample).z;</Result>
    </Metallic>
    <Roughness>
        <Calculation></Calculation>
        <Result>(t_DiamondPlate_ORMWSample).y;</Result>
    </Roughness>
    <FragmentNormal>
