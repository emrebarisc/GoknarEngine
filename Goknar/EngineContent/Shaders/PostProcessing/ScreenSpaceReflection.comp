#version 440 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) uniform image2D outputImage;

uniform sampler2D inputTexture;
uniform sampler2D position_GBuffer;
uniform sampler2D normal_GBuffer;
uniform sampler2D aoMetallicRoughness_GBuffer;

uniform mat4 viewProjectionMatrix;
uniform vec3 viewPosition;

uniform float rayStepSize = 0.5f;
uniform int maxSteps = 50;
uniform float thickness = 0.5f;

bool IsValidUv(vec2 uv)
{
    return
        0.0f <= uv.x && uv.x <= 1.0f &&
        0.0f <= uv.y && uv.y <= 1.0f;
}

vec2 ClampUvToViewport(vec2 uv, vec2 texelSize)
{
    return clamp(uv, texelSize * 0.5f, vec2(1.0f) - texelSize * 0.5f);
}

float LengthSquared(vec3 value)
{
    return dot(value, value);
}

bool IsValidNormal(vec3 normal)
{
    return LengthSquared(normal) > 0.000001f;
}

// Background G-buffer pixels usually have both zero position and zero normal.
// Checking only world position incorrectly rejects valid geometry at the world origin.
bool IsBackgroundSample(vec3 worldPos, vec3 rawNormal)
{
    return LengthSquared(worldPos) < 0.000001f && !IsValidNormal(rawNormal);
}

vec4 ProjectWorldPosition(vec3 worldPos)
{
    // GLSL uses column vectors. The world basis is +X forward, +Y left, +Z up;
    // the camera's view-projection matrix is responsible for mapping that basis to clip space.
    return viewProjectionMatrix * vec4(worldPos, 1.0f);
}

bool EvaluateHit(
    vec3 rayOrigin,
    vec3 reflectionDirection,
    vec3 rayPosition,
    vec3 sampleWorldPosition,
    float currentStepSize,
    out float forwardError,
    out float lateralError)
{
    vec3 sampleOffset = sampleWorldPosition - rayOrigin;
    float projectedDistanceToSample = dot(sampleOffset, reflectionDirection);
    if (projectedDistanceToSample <= 0.0f)
    {
        forwardError = 0.0f;
        lateralError = 0.0f;
        return false;
    }

    float marchedDistance = dot(rayPosition - rayOrigin, reflectionDirection);
    vec3 closestPointOnRay = rayOrigin + reflectionDirection * projectedDistanceToSample;

    forwardError = marchedDistance - projectedDistanceToSample;
    lateralError = length(sampleWorldPosition - closestPointOnRay);

    // Clamped lateral error prevents the ray hit-box from expanding infinitely
    const float allowedLateralError = max(thickness * 2.0f, min(currentStepSize * 0.25f, thickness * 5.0f));
    
    return
        0.0f <= forwardError &&
        forwardError <= (currentStepSize + thickness) &&
        lateralError <= allowedLateralError;
}

vec2 GetNormalizedScreenDirection(vec2 sourceUv, vec2 targetUv, vec2 fallbackUv)
{
    vec2 direction = targetUv - sourceUv;
    float directionLength = length(direction);
    if (directionLength <= 0.0001f)
    {
        direction = sourceUv - fallbackUv;
        directionLength = length(direction);
    }

    if (directionLength <= 0.0001f)
    {
        return vec2(0.0f);
    }

    return direction / directionLength;
}

vec2 ProjectUvToViewportEdge(vec2 originUv, vec2 direction)
{
    if (length(direction) <= 0.0001f)
    {
        return clamp(originUv, vec2(0.001f), vec2(0.999f));
    }

    float travelToVerticalEdge = 1e20f;
    if (direction.x > 0.0001f)
    {
        travelToVerticalEdge = (1.0f - originUv.x) / direction.x;
    }
    else if (direction.x < -0.0001f)
    {
        travelToVerticalEdge = -originUv.x / direction.x;
    }

    float travelToHorizontalEdge = 1e20f;
    if (direction.y > 0.0001f)
    {
        travelToHorizontalEdge = (1.0f - originUv.y) / direction.y;
    }
    else if (direction.y < -0.0001f)
    {
        travelToHorizontalEdge = -originUv.y / direction.y;
    }

    float travelToEdge = max(min(travelToVerticalEdge, travelToHorizontalEdge), 0.0f);
    return clamp(originUv + direction * travelToEdge, vec2(0.001f), vec2(0.999f));
}

bool PredictOffScreenReflectionColor(
    vec2 surfaceUv,
    vec2 lastValidUv,
    vec2 invalidUv,
    vec2 imageSize,
    out vec3 predictedColor,
    out float predictionConfidence)
{
    vec2 texelSize = 1.0f / imageSize;
    vec2 direction = GetNormalizedScreenDirection(lastValidUv, invalidUv, surfaceUv);
    if (length(direction) <= 0.0001f)
    {
        predictedColor = vec3(0.0f);
        predictionConfidence = 0.0f;
        return false;
    }

    vec2 edgeUv = ProjectUvToViewportEdge(lastValidUv, direction);
    vec2 inwardDirection = -direction;
    vec2 tangentDirection = vec2(-direction.y, direction.x);

    const float baseTapDistances[4] = float[](1.5f, 4.0f, 7.5f, 12.0f);
    const float baseTapWeights[4] = float[](1.0f, 0.85f, 0.6f, 0.4f);

    vec3 accumulatedColor = vec3(0.0f);
    float accumulatedWeight = 0.0f;
    float accumulatedConfidence = 0.0f;

    for (int tapIndex = 0; tapIndex < 4; ++tapIndex)
    {
        float tapDistance = baseTapDistances[tapIndex];
        float tapWeight = baseTapWeights[tapIndex];
        vec2 baseUv = ClampUvToViewport(edgeUv + inwardDirection * texelSize * tapDistance, texelSize);

        for (int lateralIndex = -1; lateralIndex <= 1; ++lateralIndex)
        {
            float lateralWeight = lateralIndex == 0 ? 1.0f : 0.45f;
            vec2 lateralUv = ClampUvToViewport(baseUv + tangentDirection * texelSize * float(lateralIndex) * 1.5f, texelSize);
            vec3 lateralWorldPosition = texture(position_GBuffer, lateralUv).xyz;
            vec3 lateralRawNormal = texture(normal_GBuffer, lateralUv).xyz;
            if (IsBackgroundSample(lateralWorldPosition, lateralRawNormal))
            {
                continue;
            }

            float finalWeight = tapWeight * lateralWeight;
            accumulatedColor += texture(inputTexture, lateralUv).rgb * finalWeight;
            accumulatedWeight += finalWeight;
            accumulatedConfidence += finalWeight;
        }
    }

    if (accumulatedWeight <= 0.0001f)
    {
        predictedColor = texture(inputTexture, ClampUvToViewport(edgeUv, texelSize)).rgb;
        predictionConfidence = 0.0f;
        return false;
    }

    predictedColor = accumulatedColor / accumulatedWeight;

    float predictionTravelPixels = length((edgeUv - lastValidUv) * imageSize);
    float sourceDistancePixels = length((lastValidUv - surfaceUv) * imageSize);
    float screenEdgeConfidence = 1.0f - clamp(predictionTravelPixels / 24.0f, 0.0f, 1.0f);
    float sourceConfidence = smoothstep(2.0f, 18.0f, sourceDistancePixels);
    float sampleConfidence = clamp(accumulatedConfidence / 3.0f, 0.0f, 1.0f);

    predictionConfidence = screenEdgeConfidence * sourceConfidence * sampleConfidence;
    return 0.05f < predictionConfidence;
}

void main() {
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(outputImage);
    if (pixelCoords.x >= outputSize.x || pixelCoords.y >= outputSize.y)
    {
        return;
    }

    vec2 imageSize = vec2(outputSize);
    vec2 uv = (vec2(pixelCoords) + vec2(0.5f)) / imageSize;

    vec4 sceneColor = texture(inputTexture, uv);
    vec3 worldPos = texture(position_GBuffer, uv).xyz;
    vec3 rawNormal = texture(normal_GBuffer, uv).xyz;

    // Ignore skybox / background pixels to prevent breaking the depth math.
    // Do not classify by world position alone: valid geometry can be at (0, 0, 0).
    if (IsBackgroundSample(worldPos, rawNormal)) {
        imageStore(outputImage, pixelCoords, sceneColor);
        return;
    }

    if (!IsValidNormal(rawNormal)) {
        imageStore(outputImage, pixelCoords, sceneColor);
        return;
    }

    vec3 normal = normalize(rawNormal);
    vec3 aoMetallicRoughness = texture(aoMetallicRoughness_GBuffer, uv).xyz;

    float metallic = aoMetallicRoughness.y;
    float roughness = aoMetallicRoughness.z;
    float reflectionIntensity = clamp(metallic * (1.0f - roughness), 0.0f, 1.0f);

    // Early exit for non-reflective surfaces
    if (reflectionIntensity <= 0.01f) {
        imageStore(outputImage, pixelCoords, sceneColor);
        return;
    }

    float safeRayStepSize = max(rayStepSize, 0.001f);
    float safeThickness = max(thickness, 0.001f);
    int safeMaxSteps = max(maxSteps, 1);

    vec3 viewDirection = normalize(worldPos - viewPosition);
    vec3 reflectionDirection = normalize(reflect(viewDirection, normal));
    if (length(reflectionDirection) < 0.1f)
    {
        imageStore(outputImage, pixelCoords, sceneColor);
        return;
    }

    // Bias to prevent immediate self-intersection
    vec3 rayOrigin = worldPos + normal * max(safeThickness * 0.5f, 0.05f);
    vec3 previousRayPosition = rayOrigin;
    
    float currentStepSize = safeRayStepSize;

    // THE FIX: Define a maximum allowed step size. 
    // This prevents the ray from taking giant leaps and missing the pillar completely.
    float maxAllowedStepSize = safeRayStepSize * 3.5f;

    // Interleaved Gradient Noise (IGN) jitter to break horizontal stepping artifacts
    float dither = fract(52.9829189f * fract(dot(vec2(pixelCoords), vec2(0.06711056f, 0.00583715f))));
    float initialOffset = currentStepSize * dither;
    
    vec3 rayPosition = rayOrigin + reflectionDirection * initialOffset;
    
    vec3 hitColor = vec3(0.0f);
    float visibility = 0.0f;
    vec2 hitUV = vec2(-1.0f);
    float hitLateralError = thickness * 2.0f;
    float totalRayDistance = initialOffset; 
    bool exitedViewportWithoutHit = false;
    vec2 lastValidUv = uv;
    vec2 invalidHitUv = uv;

    for (int i = 0; i < safeMaxSteps; ++i) {
        previousRayPosition = rayPosition;
        rayPosition += reflectionDirection * currentStepSize;
        totalRayDistance += currentStepSize;

        vec4 clipSpace = ProjectWorldPosition(rayPosition);
        if (clipSpace.w <= 0.00001f)
        {
            exitedViewportWithoutHit = true;
            invalidHitUv = lastValidUv + (lastValidUv - uv);
            break;
        }

        vec3 ndc = clipSpace.xyz / clipSpace.w;
        vec2 sampleUV = ndc.xy * 0.5f + 0.5f;

        // Break if off-screen
        if (!IsValidUv(sampleUV)) {
            exitedViewportWithoutHit = true;
            invalidHitUv = sampleUV;
            break;
        }

        lastValidUv = sampleUV;

        vec3 sampleWorldPos = texture(position_GBuffer, sampleUV).xyz;
        
        vec3 sampleRawNormal = texture(normal_GBuffer, sampleUV).xyz;

        // Skip background pixels in the G-Buffer
        if (IsBackgroundSample(sampleWorldPos, sampleRawNormal)) {
            // Apply capped growth
            currentStepSize = min(currentStepSize * 1.05f, maxAllowedStepSize);
            continue;
        }

        float forwardError = 0.0f;
        float lateralError = 0.0f;
        if (EvaluateHit(rayOrigin, reflectionDirection, rayPosition, sampleWorldPos, currentStepSize, forwardError, lateralError)) {
            if (!IsValidNormal(sampleRawNormal)) {
                currentStepSize = min(currentStepSize * 1.05f, maxAllowedStepSize);
                continue;
            }

            vec3 sampleNormal = normalize(sampleRawNormal);
            
            // Backface Rejection: Prevent the ray from hitting the "inside" or grazing its own geometry
            if (dot(sampleNormal, reflectionDirection) > 0.0f) {
                // Apply capped growth
                currentStepSize = min(currentStepSize * 1.05f, maxAllowedStepSize);
                continue;
            }

            // Binary Search Refinement
            vec3 minRayPosition = previousRayPosition;
            vec3 maxRayPosition = rayPosition;
            vec2 refinedHitUv = sampleUV;
            float refinedLateralError = lateralError;

            for (int j = 0; j < 6; ++j) {
                vec3 midRayPosition = mix(minRayPosition, maxRayPosition, 0.5f);
                clipSpace = ProjectWorldPosition(midRayPosition);
                if (clipSpace.w <= 0.00001f)
                {
                    maxRayPosition = midRayPosition;
                    continue;
                }

                sampleUV = (clipSpace.xy / clipSpace.w) * 0.5f + 0.5f;
                if (!IsValidUv(sampleUV))
                {
                    maxRayPosition = midRayPosition;
                    continue;
                }
                
                sampleWorldPos = texture(position_GBuffer, sampleUV).xyz;
                vec3 refinedRawNormal = texture(normal_GBuffer, sampleUV).xyz;
                if (IsBackgroundSample(sampleWorldPos, refinedRawNormal))
                {
                    minRayPosition = midRayPosition;
                    continue;
                }

                // Calculate the precise, shrinking step size for this specific iteration
                float searchStepSize = length(maxRayPosition - minRayPosition) * 0.5f;

                float refinedForwardError = 0.0f;
                float candidateLateralError = 0.0f;
                bool midRayHits = EvaluateHit(
                    rayOrigin,
                    reflectionDirection,
                    midRayPosition,
                    sampleWorldPos,
                    searchStepSize, 
                    refinedForwardError,
                    candidateLateralError);
                
                if (midRayHits) {
                    maxRayPosition = midRayPosition;
                    refinedHitUv = sampleUV;
                    refinedLateralError = candidateLateralError;
                } else {
                    minRayPosition = midRayPosition;
                }
            }

            hitUV = refinedHitUv;
            hitLateralError = refinedLateralError;
            break;
        }
        
        // Exponential step growth: Capped so it doesn't skip thin geometry
        currentStepSize = min(currentStepSize * 1.05f, maxAllowedStepSize);
    }

    if (hitUV.x >= 0.0f) {
        hitColor = texture(inputTexture, hitUV).rgb;
        
        vec2 edgeFade = smoothstep(vec2(0.0f), vec2(0.1f), hitUV) *
                        (vec2(1.0f) - smoothstep(vec2(0.9f), vec2(1.0f), hitUV));
        float fresnel = mix(0.2f, 1.0f, pow(1.0f - max(dot(-viewDirection, normal), 0.0f), 3.0f));
        float mirrorLikeBlend = smoothstep(0.85f, 1.0f, reflectionIntensity);
        float ssrBlend = mix(fresnel, 1.0f, mirrorLikeBlend);
        float hitConfidence = 1.0f - clamp(hitLateralError / max(thickness * 2.0f, 0.001f), 0.0f, 1.0f);
        float distanceFade = 1.0f - clamp(totalRayDistance / max(safeRayStepSize * float(safeMaxSteps) * 2.0f, 0.001f), 0.0f, 0.85f);
        
        visibility = edgeFade.x * edgeFade.y * reflectionIntensity * ssrBlend * hitConfidence * distanceFade;
    }
    else if (exitedViewportWithoutHit) {
        vec3 predictedColor = vec3(0.0f);
        float predictionConfidence = 0.0f;
        if (PredictOffScreenReflectionColor(uv, lastValidUv, invalidHitUv, imageSize, predictedColor, predictionConfidence))
        {
            hitColor = predictedColor;

            float fresnel = mix(0.2f, 1.0f, pow(1.0f - max(dot(-viewDirection, normal), 0.0f), 3.0f));
            float distanceFade = 1.0f - clamp(totalRayDistance / max(safeRayStepSize * float(safeMaxSteps) * 2.0f, 0.001f), 0.0f, 0.75f);
            float predictionFade = 0.45f * predictionConfidence;

            visibility = reflectionIntensity * fresnel * distanceFade * predictionFade;
        }
    }

    vec4 finalColor = vec4(mix(sceneColor.rgb, hitColor, visibility), sceneColor.a);
    imageStore(outputImage, pixelCoords, finalColor);
}
